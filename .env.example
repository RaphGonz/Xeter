# PostgreSQL
DATABASE_URL=postgresql+asyncpg://xeter:CHANGE_ME_BEFORE_DEPLOY@localhost:5432/xeter
POSTGRES_URL=postgresql://xeter:CHANGE_ME_BEFORE_DEPLOY@localhost:5432/xeter
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# Redis
REDIS_URL=redis://:CHANGE_ME_BEFORE_DEPLOY@localhost:6379
REDIS_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# MinIO / S3
MINIO_ENDPOINT=http://localhost:9100
MINIO_ROOT_USER=xeter
MINIO_ROOT_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
MINIO_ACCESS_KEY=xeter
MINIO_SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY
S3_ACCESS_KEY=xeter
S3_SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY
MINIO_BUCKET=xeter-payloads
S3_BUCKET=xeter-payloads

# Dev bootstrap
DEV_API_KEY=dev-api-key-local
DEV_TENANT_NAME=dev-tenant
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# App
SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY

# Diagnosticer LLM config
DIAGNOSTICER_PROVIDER=anthropic
DIAGNOSTICER_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=CHANGE_ME_BEFORE_DEPLOY
OPENAI_API_KEY=CHANGE_ME_BEFORE_DEPLOY
